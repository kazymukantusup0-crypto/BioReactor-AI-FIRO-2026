        .ai-chatbot {
            z-index: 999;
            position: fixed;
            right: 20px;
            bottom: 20px;
            width: 115px;
            height: 115px;
        }

        .ai-chatbot-icon {
            width: 60px;
            position: absolute;
            right: 0px;
            bottom: 0px;
            display: none;
            animation: aiBotIconFloat 2.5s ease-in-out infinite;
        }

        .chatbot-popup {
            display: block;
            width: 100%;
            height: 100%;
            position: relative;
            z-index: 2;
        }

        .ai-chatbot video,
        .chatbot__video {
            display: block;
            width: 100%;
            height: auto;
        }

        .ai-chatbot__bubble {
            position: absolute;
            right: 15px;
            bottom: 110px;
            width: 220px;
            opacity: 0;
            visibility: hidden;
            transform: translateY(12px) scale(0.96);
            transition:
                    opacity .45s ease,
                    transform .45s ease,
                    visibility .45s ease;
            z-index: 3;
        }

        .ai-chatbot__bubble.is-visible {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        .ai-chatbot__bubble-img {
            display: block;
            width: 100%;
            height: auto;
        }

        @keyframes aiBotIconFloat {
            0% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(-5px);
            }
            100% {
                transform: translateY(0);
            }
        }

        @media (max-width: 768px) {
            .ai-chatbot {
                right: 16px;
                bottom: 16px;
                width: 92px;
                height: 92px;
            }

            .ai-chatbot__bubble {
                width: 200px;
                right: 5px;
                bottom: 90px;
            }
        }

        @media (max-width: 600px) {
            .ai-chatbot-icon {
                display: block;
            }

            .chatbot__video {
                display: none!important;
            }

            .ai-chatbot__bubble {
                width: 200px;
                right: -10px;
                bottom: 75px;
            }
        }
    </style>

