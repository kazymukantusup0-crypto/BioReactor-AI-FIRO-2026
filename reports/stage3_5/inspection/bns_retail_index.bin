<script>
        $(function () {
            const $bubble = $('#aiChatbotBubble');
            const $chatbot = $('.chatbot-popup').first();

            if (!$bubble.length || !$chatbot.length) {
                return;
            }

            setTimeout(function () {
                $bubble.addClass('is-visible');
            }, 2000);

            setTimeout(function () {
                $bubble.removeClass('is-visible');
            }, 12000);

            $chatbot.on('click', function () {
                $bubble.removeClass('is-visible');
            });

            $bubble.on('click', function () {
                $bubble.removeClass('is-visible');
                $chatbot.trigger('click');
            });
        });
    </script>

