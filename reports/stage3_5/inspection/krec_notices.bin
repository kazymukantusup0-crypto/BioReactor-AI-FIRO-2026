<div id="notices-archive" class="notices-panel" style="display:none;">
    <div style="display:flex; flex-direction:column; gap:14px;">

        <div class="notice-item-card" style="background:#ffffff; border:1px solid #e2e8f0; border-radius:14px; padding:20px 24px;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
                <span style="font-size:12px; color:#64748b; font-weight:600;">2024 год</span>
                <span style="font-size:12px; color:#64748b; background:#f1f5f9; padding:2px 8px; border-radius:6px;">Архив</span>
            </div>
            <h3 style="font-size:16px; font-weight:700; color:#0f172a; margin:0 0 6px 0;">Проведение ежегодных публичных слушаний по исполнению тарифной сметы</h3>
            <p style="font-size:13.5px; color:#64748b; line-height:1.5; margin:0;">Отчет перед потребителями и иными заинтересованными лицами об исполнении утвержденной тарифной сметы на услуги по передаче электрической энергии.</p>
        </div>

        <div class="notice-item-card" style="background:#ffffff; border:1px solid #e2e8f0; border-radius:14px; padding:20px 24px;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
                <span style="font-size:12px; color:#64748b; font-weight:600;">2023 год</span>
                <span style="font-size:12px; color:#64748b; background:#f1f5f9; padding:2px 8px; border-radius:6px;">Архив</span>
            </div>
            <h3 style="font-size:16px; font-weight:700; color:#0f172a; margin:0 0 6px 0;">О соблюдении правил охранных зон электрических сетей</h3>
            <p style="font-size:13.5px; color:#64748b; line-height:1.5; margin:0;">Разъяснение требований безопасности при производстве земляных и строительных работ вблизи воздушных и кабельных линий электропередач напряжением 0,4–110 кВ.</p>
        </div>
    </div>
</div>

<script>
function switchNoticesTab(tab, btn) {
    document.querySelectorAll('.notices-panel').forEach(p => p.style.display = 'none');
    document.querySelectorAll('.cl-tabs-header .cl-tab-btn').forEach(b => b.classList.remove('active'));
    const target = document.getElementById('notices-' + tab);
    if (target) target.style.display = 'block';
    btn.classList.add('active');
}
function filterNotices() {
    const q = (document.getElementById('noticesSearch').value || '').toLowerCase().trim();
    const cards = document.querySelectorAll('.notice-item-card');
    cards.forEach(c => {
        const text = c.textContent.toLowerCase();
        c.style.display = (!q || text.includes(q)) ? 'block' : 'none';
    });
}
</script>

