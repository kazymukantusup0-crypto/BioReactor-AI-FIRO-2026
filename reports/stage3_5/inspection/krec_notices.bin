<div class="content-container">
<style>
.price-notice-posters {margin:22px 0;}
.price-poster-language {max-width:680px;margin:0 auto;}
.price-poster-link {display:block;overflow:hidden;border:1px solid #dbeafe;border-radius:12px;background:#eff6ff;}
.price-poster-image {display:block;width:100%;max-width:100%;height:auto;}
.price-poster-caption {margin-top:10px;text-align:center;font-size:13px;line-height:1.6;}
.price-poster-caption a {color:#2563eb;font-weight:600;text-decoration:underline;text-underline-offset:3px;}
</style>
<style>
html[lang="ru"] .price-update-kk, html[lang="kk"] .price-update-ru {display:none!important;}
.price-update-links {display:flex;flex-wrap:wrap;gap:10px;margin-top:18px;}
.price-update-links a {white-space:normal;max-width:100%;overflow-wrap:anywhere;}
.price-update-history {border:1px solid #e2e8f0;border-radius:14px;padding:20px;margin:0 0 28px;background:#fff;}
.price-update-history summary {cursor:pointer;font-weight:700;color:#0f172a;font-size:16px;}
.price-update-history[open] summary {margin-bottom:20px;}
@media(max-width:600px) {.price-update-history {padding:14px;} #price-unified .tarif-hero-card {padding:22px 18px!important;} #price-unified .tarif-params-box {min-width:0!important;width:100%;max-width:none!important;} .price-update-links a {width:100%;}}
</style>
