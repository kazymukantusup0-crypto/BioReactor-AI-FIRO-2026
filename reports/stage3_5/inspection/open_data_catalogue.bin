    var cgoGovagency = [];

    function getRandomColor() {
        var letters = '0123456789ABCDEF';
        var color = '#';
        for (var i = 0; i < 6; i++) {
            color += letters[Math.floor(Math.random() * 16)];
        }
        return color;
    }

    function roundToTwo(val){
        return +(Math.round(val + "e+2")+ "e-2");
    }

