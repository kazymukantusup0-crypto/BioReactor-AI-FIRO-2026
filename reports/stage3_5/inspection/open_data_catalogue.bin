        <script type="text/javascript">
            function set(tId) {
                if (tId == 1) {
                    eLid += tId;
                    $('#mainBlock').show()
                    $('#expType').val(1)
                    $('#govAgencyId').prop('required', true)
                }
                if (eLid > 1) {
                    $('#mainBlock').hide();
                    eLid = 0;
                    $('#expType').val(0)
                    $('#govAgencyId').prop('required', false)
                }
            }
            function mainReset() {
                $("#searchM").trigger('reset');
            }
        </script>
