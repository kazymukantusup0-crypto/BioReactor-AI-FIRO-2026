            <p id="timeDisplay"></p>
            <script type="text/javascript">
                document.getElementById('timeDisplay').innerHTML = getDate();
                function getDate() {
                    var date = new Date();
                    var day = date.getDate();
                    var year = date.getFullYear().toString();
                    var monthList = new Array("қаңтар", "ақпан", "наурыз", "сәуір", "мамыр", "маусым", "шілде", "тамыз", "қыркүйек", "қазан", "қараша", "желтоксан");
                    var months = monthList[date.getMonth()];
                    return '<p style="margin: 15px">'+day+' '+months+' '+year+'</p>';
                }
            </script>
