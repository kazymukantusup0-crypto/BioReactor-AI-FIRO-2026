<script>
(function () {
  var modal = document.querySelector('.certificate-modal');
  if (!modal) return;

  var modalImg = modal.querySelector('[data-certificate-modal-img]');
  var modalTitle = modal.querySelector('[data-certificate-modal-title]');
  var modalDownload = modal.querySelector('[data-certificate-modal-download]');
  var lastFocus = null;

  function openModal(src, title) {
    lastFocus = document.activeElement;
    modalImg.src = src;
    modalImg.alt = title || 'Сертификат';
    modalTitle.textContent = title || 'Сертификат';
    modalDownload.href = src;
    modal.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    var closeBtn = modal.querySelector('[data-certificate-close]');
    if (closeBtn) closeBtn.focus();
  }

  function closeModal() {
    modal.hidden = true;
    modalImg.src = '';
    document.documentElement.style.overflow = '';
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }

  document.addEventListener('click', function (e) {
    var opener = e.target.closest('[data-certificate-open]');
    if (opener) {
      e.preventDefault();
      openModal(opener.getAttribute('data-certificate-open'), opener.getAttribute('data-certificate-title'));
      return;
    }

    if (e.target.closest('[data-certificate-close]')) {
      e.preventDefault();
      closeModal();
    }
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });
})();


</script>

