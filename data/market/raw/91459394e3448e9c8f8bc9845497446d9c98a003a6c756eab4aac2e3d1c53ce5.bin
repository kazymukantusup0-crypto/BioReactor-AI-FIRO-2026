		/* ==== Years Pills (".yearspi") ==== */
.yearspi {
  /* ваши фирменные цвета можно подставить сюда */
  --accent: #D7A752;
  --gold1: #F7D87B;
  --gold2: #C08436;

  /* базовые */
  --bg: #161616;
  --text: #fff;
  --muted: #ffffff99;

  /* чип */
  --chip-bg: rgba(255,255,255,.06);
  --chip-border: rgba(215,167,82,.35);
}

.yearspi ul {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  padding: 0;
  margin: 0;
  list-style: none; /* вместо inline style */
  justify-content: flex-start;
}

.yearspi li { list-style: none; }

.yearspi a {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-width: 84px;
  padding: 10px 18px;
  border-radius: 999px;

  font-size: 20px;
  letter-spacing: .2px;
  color: var(--text);
  text-decoration: none;

  background: linear-gradient(180deg, var(--chip-bg), rgba(255,255,255,.02));
  border: 1px solid var(--chip-border);
  backdrop-filter: blur(4px);

  box-shadow:
    inset 0 6px 20px rgba(0,0,0,.18),
    0 1px 0 rgba(255,255,255,.04);
  transition:
    transform .15s ease,
    box-shadow .2s ease,
    background-color .2s ease,
    border-color .2s ease,
    color .2s ease;
}

/* Hover */
.yearspi a:hover {
  transform: translateY(-1px);
  border-color: var(--accent);
  box-shadow:
    inset 0 6px 20px rgba(0,0,0,.22),
    0 6px 18px rgba(215,167,82,.25);
}

/* Active/current: добавьте aria-current="page" ИЛИ класс .is-active на текущем годе */
.yearspi a[aria-current="page"],
.yearspi a.is-active {
  color: #111;
  background: linear-gradient(135deg, var(--gold1), var(--gold2));
  border-color: transparent;
  box-shadow: 0 10px 26px rgba(192,132,54,.35);
}

/* Focus accessibility */
.yearspi a:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* Небольшая адаптивность */
@media (max-width: 480px) {
  .yearspi a {
    min-width: 72px;
    padding: 9px 14px;
    font-weight: 600;
  }
  .yearspi ul { justify-content: center; }
}

/* Светлая тема (если нужно) */
@media (prefers-color-scheme: light) {
  .yearspi {
    --text: #222;
    --bg: #fff;
    --chip-bg: rgba(0,0,0,.03);
    --chip-border: rgba(215,167,82,.45);
  }
}
.certificates-block,
.certificates-block *{box-sizing:border-box}

.certificates-block{
  --cert-blue:#0872b8;
  --cert-orange:#ef4b2a;
  --cert-dark:#132b3f;
  --cert-muted:#6c7785;
  --cert-line:#e7edf3;
  width:100%;
  margin:18px 0 34px;
}

.certificates-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:18px;
}

.certificate-card{
  --card-accent:var(--cert-blue);
  min-height:100%;
  border:1px solid var(--cert-line);
  border-radius:18px;
  background:#fff;
  box-shadow:0 12px 30px rgba(15,46,80,.08);
  overflow:hidden;
  transition:transform .22s ease, box-shadow .22s ease, border-color .22s ease;
}

.certificate-card:hover{
  transform:translateY(-4px);
  border-color:rgba(239,75,42,.42);
  box-shadow:0 20px 44px rgba(15,46,80,.14);
}

.certificate-card--blue{--card-accent:#3520df}
.certificate-card--orange{--card-accent:#ff350e}
.certificate-card--purple{--card-accent:#6c1d47}
.certificate-card--green{--card-accent:#009b10}
.certificate-card--red{--card-accent:#930000}
.certificate-card--wide{grid-column:span 2;display:grid;grid-template-columns:210px 1fr}

.certificate-card__media{
  width:100%;
  height:235px;
  border:0;
  padding:12px;
  cursor:pointer;
  display:block;
  position:relative;
  overflow:hidden;
  background:
    linear-gradient(90deg,var(--card-accent) 0 18%,#f7f9fc 18% 100%);
}

.certificate-card--wide .certificate-card__media{height:100%;min-height:245px}

.certificate-card__media img{
  width:100%;
  height:100%;
  object-fit:contain;
  display:block;
  filter:drop-shadow(0 12px 16px rgba(0,0,0,.18));
  transition:transform .28s ease;
}

.certificate-card:hover .certificate-card__media img{transform:scale(1.04)}

.certificate-card__media span{
  position:absolute;
  right:13px;
  bottom:13px;
  padding:7px 12px;
  border-radius:999px;
  color:#fff;
  background:#ef4b2a;
  font-size:12px;
  font-weight:800;
  box-shadow:0 10px 22px rgba(239,75,42,.25);
}

.certificate-card__body{padding:17px 18px 18px}

.certificate-card__standard{
  display:inline-flex;
  padding:6px 10px;
  border-radius:999px;
  color:var(--card-accent);
  background:#f3f7fb;
  font-size:12px;
  font-weight:900;
  letter-spacing:.03em;
}

.certificate-card__body h3{
  margin:11px 0 7px;
  color:var(--cert-dark);
  font-size:18px;
  line-height:1.25;
  font-weight:900;
}

.certificate-card__body p{
  margin:0;
  color:var(--cert-muted);
  font-size:14px;
  line-height:1.45;
}

.certificate-card__bottom{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-top:15px;
  padding-top:13px;
  border-top:1px solid var(--cert-line);
}

.certificate-card__bottom small{
  color:#7a8493;
  font-size:11px;
  line-height:1.25;
}

.certificate-card__bottom a{
  white-space:nowrap;
  color:#ef4b2a;
  text-decoration:none;
  font-size:13px;
  font-weight:900;
}

.certificate-card__bottom a:hover{text-decoration:underline}

.certificate-modal[hidden]{display:none!important}

.certificate-modal{
  position:fixed;
  inset:0;
  z-index:99999;
  display:grid;
  place-items:center;
  padding:24px;
}

.certificate-modal__overlay{
  position:absolute;
  inset:0;
  background:rgba(5,18,32,.72);
  backdrop-filter:blur(5px);
}

.certificate-modal__dialog{
  position:relative;
  width:min(760px,96vw);
  max-height:94vh;
  padding:18px;
  border-radius:22px;
  background:#fff;
  box-shadow:0 30px 80px rgba(0,0,0,.32);
  overflow:auto;
}

.certificate-modal__head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  margin-bottom:12px;
  padding-right:42px;
  color:var(--cert-dark);
}

.certificate-modal__head strong{font-size:16px;line-height:1.3}

.certificate-modal__head a{
  color:#fff;
  background:#ef4b2a;
  border-radius:999px;
  padding:8px 14px;
  text-decoration:none;
  font-size:13px;
  font-weight:800;
}

.certificate-modal__close{
  position:absolute;
  right:14px;
  top:12px;
  width:34px;
  height:34px;
  border:0;
  border-radius:50%;
  cursor:pointer;
  color:#fff;
  background:#15283a;
  font-size:24px;
  line-height:1;
}

.certificate-modal__dialog img{
  width:100%;
  height:auto;
  display:block;
  border-radius:14px;
  background:#f5f7fb;
}

@media(max-width:980px){
  .certificates-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .certificate-card--wide{grid-column:span 2;grid-template-columns:1fr}
  .certificate-card--wide .certificate-card__media{height:235px;min-height:0}
}

@media(max-width:700px){
  .certificates-grid{grid-template-columns:1fr}
  .certificate-card--wide{grid-column:auto}
  .certificate-card__media{height:230px}
  .certificate-card__bottom{align-items:flex-start;flex-direction:column}
}

      </style>



